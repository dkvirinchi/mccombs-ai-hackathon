# Copy to .env.local for local dev. Vercel: set these under Project > Settings > Environment Variables.
# Web app URL of the deployed Apps Script (ends in /exec). Leave empty to run the site without a backend.
NEXT_PUBLIC_APPS_SCRIPT_URL=
# "prod" writes to the production Sheet, anything else writes to the test Sheet. Set "prod" on Vercel Production only.
NEXT_PUBLIC_ENV=preview
